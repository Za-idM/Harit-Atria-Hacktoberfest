{
  "name": "harit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Harit — WhatsApp farmer helpline: text/voice/photo in any Indian language, Gemma answers",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:logs": "pm2 logs harit",
    "pm2:restart": "pm2 restart harit",
    "pm2:stop": "pm2 stop harit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^1.16.0",
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.24",
    "dotenv": "^16.6.1",
    "ffmpeg-static": "^5.2.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "pino": "^9.14.0",
    "qrcode-terminal": "^0.12.0",
    "sarvamai": "^1.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.7.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.24",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.9.3"
  }
}
